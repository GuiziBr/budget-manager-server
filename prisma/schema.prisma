// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Connection URL is configured in prisma.config.ts (Prisma v7+)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model BudgetPeriod {
  id        String    @id @default(uuid()) @db.Uuid
  year      Int
  month     Int
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  expenses       Expense[]
  incomes        Income[]
  budgetEnvelopes BudgetEnvelope[]

  // Uniqueness enforced via partial index in migration (WHERE deleted_at IS NULL)
  @@map("budget_periods")
}

model Category {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  hasBudgetEnvelope Boolean  @default(false) @map("has_budget_envelope")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  budgetEnvelopes   BudgetEnvelope[]

  // Name uniqueness enforced via partial index in migration (WHERE deleted_at IS NULL)
  @@map("categories")
}

model PaymentType {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  hasStatement Boolean   @default(false) @map("has_statement")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  // Name uniqueness enforced via partial index in migration (WHERE deleted_at IS NULL)
  @@map("payment_types")
}

model Bank {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  // Name uniqueness enforced via partial index in migration (WHERE deleted_at IS NULL)
  @@map("banks")
}

model Store {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  // Name uniqueness enforced via partial index in migration (WHERE deleted_at IS NULL)
  @@map("stores")
}

model InstallmentGroup {
  id                   String    @id @default(uuid()) @db.Uuid
  description          String
  amountPerInstallment Decimal   @map("amount_per_installment") @db.Decimal(10, 2)
  totalInstallments    Int       @map("total_installments")
  paymentIntervalDays  Int       @map("payment_interval_days")
  firstPurchasedAt     DateTime  @map("first_purchased_at") @db.Date
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)

  expenses Expense[]

  @@map("installment_groups")
}

model RecurringExpense {
  id            String    @id @default(uuid()) @db.Uuid
  categoryId    String    @map("category_id") @db.Uuid
  paymentTypeId String    @map("payment_type_id") @db.Uuid
  bankId        String?   @map("bank_id") @db.Uuid
  storeId       String?   @map("store_id") @db.Uuid
  description   String
  amount        Decimal   @db.Decimal(10, 2)
  startedAt     DateTime  @map("started_at") @db.Date
  cancelledAt   DateTime? @map("cancelled_at") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  category    Category    @relation(fields: [categoryId], references: [id])
  paymentType PaymentType @relation(fields: [paymentTypeId], references: [id])
  bank        Bank?       @relation(fields: [bankId], references: [id])
  store       Store?      @relation(fields: [storeId], references: [id])
  expenses    Expense[]

  @@map("recurring_expenses")
}

model Expense {
  id                 String    @id @default(uuid()) @db.Uuid
  budgetPeriodId     String    @map("budget_period_id") @db.Uuid
  categoryId         String    @map("category_id") @db.Uuid
  paymentTypeId      String    @map("payment_type_id") @db.Uuid
  bankId             String?   @map("bank_id") @db.Uuid
  storeId            String?   @map("store_id") @db.Uuid
  installmentGroupId String?   @map("installment_group_id") @db.Uuid
  recurringExpenseId String?   @map("recurring_expense_id") @db.Uuid
  description        String
  installmentNumber  Int?      @map("installment_number")
  purchasedAt        DateTime? @map("purchased_at") @db.Date
  dueAt              DateTime? @map("due_at") @db.Date
  paidAt             DateTime? @map("paid_at") @db.Date
  amount             Decimal   @db.Decimal(10, 2)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  budgetPeriod     BudgetPeriod      @relation(fields: [budgetPeriodId], references: [id])
  category         Category          @relation(fields: [categoryId], references: [id])
  paymentType      PaymentType       @relation(fields: [paymentTypeId], references: [id])
  bank             Bank?             @relation(fields: [bankId], references: [id])
  store            Store?            @relation(fields: [storeId], references: [id])
  installmentGroup InstallmentGroup? @relation(fields: [installmentGroupId], references: [id])
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])

  @@map("expenses")
}

model BudgetEnvelope {
  id              String    @id @default(uuid()) @db.Uuid
  budgetPeriodId  String    @map("budget_period_id") @db.Uuid
  categoryId      String    @map("category_id") @db.Uuid
  allocatedAmount Decimal   @map("allocated_amount") @db.Decimal(10, 2)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  budgetPeriod BudgetPeriod @relation(fields: [budgetPeriodId], references: [id])
  category     Category     @relation(fields: [categoryId], references: [id])

  // Uniqueness enforced via partial index in migration (WHERE deleted_at IS NULL)
  @@map("budget_envelopes")
}

model Income {
  id             String    @id @default(uuid()) @db.Uuid
  budgetPeriodId String    @map("budget_period_id") @db.Uuid
  description    String
  amount         Decimal   @db.Decimal(10, 2)
  isSalary       Boolean   @default(false) @map("is_salary")
  receivedAt     DateTime? @map("received_at") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  budgetPeriod BudgetPeriod @relation(fields: [budgetPeriodId], references: [id])

  @@map("incomes")
}
