{
  "name": "budget-manager-server",
  "version": "0.0.1",
  "description": "Budge manager server",
  "author": "Ricardo Guizi",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "npx @biomejs/biome lint",
    "check": "npx @biomejs/biome check",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "fix": "npx @biomejs/biome check --write",
    "migrate": "npx prisma migrate dev",
    "seed": "npx prisma db seed",
    "docker:up": "docker compose up",
    "docker:build": "docker compose up --build",
    "docker:down": "docker compose down -v",
    "docker:migrate:dev": "docker compose exec server npx prisma migrate dev",
    "docker:migrate:deploy": "docker compose exec server npx prisma migrate deploy",
    "docker:seed": "docker compose exec server npx prisma db seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@nestjs/cli": "^12.0.9",
    "@nestjs/schematics": "^12.0.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.11.11",
    "@vitest/coverage-v8": "^5.0.5",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "~6.0.2",
    "ultracite": "^8.1.0",
    "vitest": "^5.0.5",
    "webpack": "^5.112.2",
    "webpack-node-externals": "^3.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
