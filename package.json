{
  "name": "budget-manager-server",
  "version": "0.0.1",
  "description": "Budge manager server",
  "author": "Ricardo Guizi",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "npx @biomejs/biome lint --write",
    "migrate": "npx prisma migrate dev",
    "docker:up": "docker compose up",
    "docker:build": "docker compose up --build",
    "docker:down": "docker compose down -v",
    "docker:migrate:dev": "docker compose exec server npx prisma migrate dev",
    "docker:migrate:deploy": "docker compose exec server npx prisma migrate deploy",
    "docker:seed": "docker compose exec server npx prisma db seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "@types/pg": "^8.11.11",
    "prisma": "^7.5.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "ultracite": "^7.3.2",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
